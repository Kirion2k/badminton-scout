# Local development defaults. `make setup` copies this to .env (git-ignored).
# Real credentials never go in this file.

# compose.yaml
POSTGRES_USER=scout
POSTGRES_PASSWORD=scout-dev-only
POSTGRES_DB=scout
POSTGRES_PORT=5433

# backend (scout.config.Settings). Both are required, with no defaults.
# Tests create a separate <POSTGRES_DB>_test database, and only on a localhost server.
SCOUT_ENV=development
SCOUT_DATABASE_URL=postgresql+psycopg://scout:scout-dev-only@localhost:5433/scout
