<?xml version="1.0" encoding="UTF-8"?>
<!-- Template: `make schedule-install` fills in REPO and loads it as a LaunchAgent. It runs only
     while this Mac is on and logged in; launchd runs a missed time once after wake. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.badminton-scout.sync</string>
  <key>ProgramArguments</key><array><string>REPO/tools/scheduling/sync.sh</string></array>
  <!-- 00:30 UTC, just after the daily request budget resets. launchd uses local time, so
       `make schedule-install` converts it (e.g. 13:30 in New Zealand during daylight time). -->
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>HOUR</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>REPO/.tools/sync.log</string>
  <key>StandardErrorPath</key><string>REPO/.tools/sync.log</string>
</dict>
</plist>
